<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/t_ring"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Erledigt"
        android:padding="12dp"
        android:src="@drawable/ring_p2" />

    <LinearLayout
        android:id="@+id/t_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/t_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="#F2F2F2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/t_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="#9A9A9A"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/t_flag"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Markiert"
        android:src="@drawable/dot_red"
        android:visibility="gone" />
</LinearLayout>
